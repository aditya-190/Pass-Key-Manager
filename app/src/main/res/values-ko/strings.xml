    <string name="store_unavailable">이 기기에서는 Google Play를 사용할 수 없습니다.</string>
    <string name="autofill">자동 완성</string>
    <string name="autofill_unlock">잠금 해제 후 입력</string>
    <string name="autofill_open_app">PassKey를 열어 보관함 설정을 완료한 후 다시 시도하세요.</string>
    <string name="autofill_save_failed">이 로그인 정보를 저장하지 못했습니다.</string>
