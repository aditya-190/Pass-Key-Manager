    <string name="migration_export_first">먼저 백업 내보내기</string>
    <string name="migration_export_now">지금 보관함 내보내기</string>
    <string name="recovery_password_hint">복구 비밀번호</string>
    <string name="recovery_password_too_weak">추측하기 쉬운 비밀번호입니다. 더 긴 비밀번호나 서로 관련 없는 단어 몇 개를 사용하세요.</string>
