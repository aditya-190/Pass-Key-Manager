    <string name="authenticator">인증기</string>
    <string name="add_authenticator">인증기 추가</string>
    <string name="authenticator_input_hint">otpauth:// 링크를 붙여넣거나 비밀 키를 입력하세요</string>
    <string name="authenticator_invalid">유효한 인증 키가 아닙니다.</string>
