<?xml version="1.0" encoding="utf-8"?>
<!-- 6.0.0 icon shortcuts. They only open PassKey; Home acts on them after the vault is unlocked. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_entry"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_short"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent
            android:action="com.bhardwaj.passkey.action.ADD_ENTRY"
            android:targetPackage="com.bhardwaj.passkey"
            android:targetClass="com.bhardwaj.passkey.presentation.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="com.bhardwaj.passkey.action.SEARCH"
            android:targetPackage="com.bhardwaj.passkey"
            android:targetClass="com.bhardwaj.passkey.presentation.MainActivity" />
    </shortcut>
</shortcuts>
