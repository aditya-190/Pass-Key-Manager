    <string name="migration_message">আপনার এন্ট্রিগুলি এই ডিভাইসের অনন্য কী দিয়ে পুনরায় এনক্রিপ্ট করা হচ্ছে। অ্যাপটি খোলা রাখুন।</string>
    <string name="migration_failed_title">ভল্ট সুরক্ষিত করা শেষ করা যায়নি</string>
    <string name="migration_failed_message">কিছুই হারায়নি এবং আপনার এন্ট্রি অক্ষত আছে। আবার চেষ্টা করুন, বা পরে অ্যাপ খুলুন।</string>
    <string name="migration_failed_message_can_export">কিছুই হারায়নি — আপনার ভল্ট অক্ষত ও পঠনযোগ্য। আবার চেষ্টা করুন, বা আগে সেটিংস থেকে ব্যাকআপ নিন।</string>
