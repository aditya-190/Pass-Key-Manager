    <string name="recovery_change_new_title">নতুন পুনরুদ্ধার পাসওয়ার্ড বাছুন</string>
    <string name="recovery_change_new_message">এটি আপনার পুরনো পুনরুদ্ধার পাসওয়ার্ড প্রতিস্থাপন করে। এটি রিসেট করা যায় না, তাই নিরাপদে রাখুন।</string>
