    <string name="device_lock_required_title">ডিভাইস লক প্রয়োজন</string>
    <string name="device_lock_required_message">PassKey আপনার ভল্ট ডিভাইসের স্ক্রিন লক দিয়ে সুরক্ষিত রাখে। চালিয়ে যেতে পিন, প্যাটার্ন, পাসওয়ার্ড বা বায়োমেট্রিক সেট করুন।</string>
