<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        A password manager has no use for an advertising ID. firebase-analytics merges these in;
        removing them keeps the Play Data-safety answer honest ("no advertising ID").
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <!--
        INTERNET is declared explicitly rather than merged in silently. The app itself makes no
        network calls; Firebase (only with consent) and Play in-app update require it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Autofill trust on first use reads the signing certificate of the app being filled. On Android 11+ that app
        must be visible to PassKey; apps with a login screen have a launcher activity. Narrower than
        QUERY_ALL_PACKAGES, which is not used.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".PasskeyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PassKey">
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PassKey">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 6.0.0 icon shortcuts (Add entry, Search). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Nothing is collected until the user chooses on the consent screen. ConsentApplier turns on
            only what they allowed, at runtime, from Application.onCreate.
        -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_performance_collection_enabled"
            android:value="false" />
        <!-- screen_view comes from navigation (route names only), not one per Activity. -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_analytics_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <!--
            Autofill. BIND_AUTOFILL_SERVICE is held by the system, not requested by the app: it
            is what guarantees only the framework can bind to this service.
        -->
        <service
            android:name=".presentation.autofill.PasskeyAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />

            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>

        <!--
            Launched by the framework from the autofill suggestion list when the vault is locked.
            Not exported: only the PendingIntent the service hands out can start it.
        -->
        <activity
            android:name=".presentation.autofill.AutofillUnlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.PassKey" />

        <!-- 6.0.0: PassKey in Android 14's sign-in sheet (passwords). Off below API 34. -->
        <service
            android:name=".presentation.credentials.PasskeyCredentialProviderService"
            android:enabled="@bool/credential_provider_enabled"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE"
            tools:targetApi="34">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>

            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

        <activity
            android:name=".presentation.credentials.CredentialUnlockActivity"
            android:enabled="@bool/credential_provider_enabled"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.PassKey"
            tools:targetApi="34" />

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>